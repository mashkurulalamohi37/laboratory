# Copy to .env and fill in. NEVER commit .env. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Settings are documented in docs/deployment/environment.md.

# --- Runtime -----------------------------------------------------------------
# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=nirnoy
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=nirnoy
# Used when running the API on the host (outside Docker):
DATABASE_URL=postgresql+asyncpg://nirnoy:change-me-postgres@localhost:5432/nirnoy

# --- Redis ---------------------------------------------------------------------
# required in staging/production
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible: SeaweedFS locally, S3 in production) ------------
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_ACCESS_KEY=nirnoy-dev
S3_SECRET_KEY=change-me-storage-secret
# Server-side encryption for private objects. Empty for the local emulator; AES256 on S3.
S3_SERVER_SIDE_ENCRYPTION=
S3_BUCKET_PREFIX=nirnoy
S3_REGION=ap-southeast-1

# --- Auth ----------------------------------------------------------------------
# >= 32 chars; placeholder values are rejected in staging/production.
JWT_SECRET=change-me-dev-only-jwt-secret-0123456789abcdef
OTP_HMAC_SECRET=change-me-dev-only-otp-secret-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# must be true outside development (HTTPS)
REFRESH_COOKIE_SECURE=false
STAFF_TWO_FACTOR_REQUIRED=true

# --- SMS -----------------------------------------------------------------------
# console = prints codes to the API stdout (development/test only; rejected elsewhere).
SMS_PROVIDER=console

# --- Seed ----------------------------------------------------------------------
# Bootstrap super admin, created only if no super admin exists.
SEED_SUPERADMIN_PHONE=01700000000
SEED_SUPERADMIN_PASSWORD=change-me-Admin-2026
SEED_SUPERADMIN_NAME=Platform Owner
SEED_SUPERADMIN_EMAIL=
# Shared password for the DEMO staff accounts created by `seed --demo` (development only).
DEMO_STAFF_PASSWORD=Demo-Staff-2026

# --- Gateway (docker-compose) -----------------------------------------------------
WEB_HOST=localhost
CONSOLE_HOST=console.localhost
HTTP_PORT=80
# host port for the dev API (change if 8000 is taken)
API_PORT=8000

# --- Observability ------------------------------------------------------------------
SENTRY_DSN=
